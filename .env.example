# Copy this file to .env and fill in your own values.
BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE
# Numeric Telegram user ID where feedback should be delivered.
ADMIN_ID=123456789
# Interactive map opened inside Telegram (Mini App). Leave out to use the site's
# miniapp.html, or set to "off" to run the bot with the text map only.
# WEBAPP_URL=https://worldofinventions.github.io/miniapp.html
# The Russian-language museum (ru/ package, @lshpdigitalmuseumbot). Leave out to run
# World of Inventions alone. WARNING: running locally with it switches that bot to polling.
# RU_BOT_TOKEN=PASTE_THE_RUSSIAN_BOT_TOKEN_HERE
